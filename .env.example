# Copy to .env for local Docker Compose testing only.
# In Balena Cloud, configure these values in fleet/device environment variables.

MYSQL_DATABASE=passbolt
MYSQL_USER=passbolt
MYSQL_PASSWORD=passbolt_dev_password
APP_FULL_BASE_URL=https://passbolt.local

# Optional host port mapping for local development
PASSBOLT_SMTP_PORT=587
PASSBOLT_HTTP_PORT=8088
PASSBOLT_HTTPS_PORT=8443

# Optional Wi-Fi service tuning
DBUS_SYSTEM_BUS_ADDRESS=unix:path=/host/run/dbus/system_bus_socket
DECONZ_DEVICE=/dev/ttyAMA0
TZ=Europe/Berlin
